dataIn[7] => dataReg[7].DATAIN
validIn => always0.IN1
ready << ready~reg0.DB_MAX_OUTPUT_PORT_TYPE
dataOut[0] << dataOut[0]~reg0.DB_MAX_OUTPUT_PORT_TYPE
