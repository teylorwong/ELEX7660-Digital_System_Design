clk2 => dataOut[2]~reg0.CLK
clk2 => dataOut[3]~reg0.CLK
clk2 => dataOut[4]~reg0.CLK
clk2 => dataOut[5]~reg0.CLK
clk2 => dataOut[6]~reg0.CLK
clk2 => dataOut[7]~reg0.CLK
clk2 => validOut~reg0.CLK
clk2 => ack~reg0.CLK
clk2 => req2b~reg0.CLK
clk2 => req2a~reg0.CLK
clk2 => state~3.DATAIN
rst1 => ack1b~reg0.ACLR
rst1 => ack1a~reg0.ACLR
rst1 => dataReg[0].ACLR
rst1 => dataReg[1].ACLR
rst1 => dataReg[2].ACLR
rst1 => dataReg[3].ACLR
rst1 => dataReg[4].ACLR
rst1 => dataReg[5].ACLR
rst1 => dataReg[6].ACLR
rst1 => dataReg[7].ACLR
